PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ticketharbor?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ticketharbor?retryWrites=true&w=majority
JWT_ACCESS_SECRET=your_jwt_access_secret_32chars_min
JWT_REFRESH_SECRET=your_jwt_refresh_secret_32chars_min
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
CLIENT_URL=https://ticket-harbour.vercel.app

# Payment settings
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
FROM_EMAIL=noreply@ticketharbor.com
FROM_NAME=TicketHarbor
